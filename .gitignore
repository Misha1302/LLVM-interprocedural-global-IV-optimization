/CMakeUserPresets.json

# C/C++ build artifacts
*.o
*.obj
*.lo
*.a
*.lib
*.so
*.so.*
*.dylib
*.dll
*.d

# Regression runner output
/tests/last-output/

# Python tooling
__pycache__/
*.py[cod]
.venv/

# Profiling / coverage output
*.profraw
*.profdata
*.gcda
*.gcno
*.gcov

# Crash dumps
/core
/core.*
*.stackdump

# IDE / editor state
/.idea/
*.iml
/.vscode/
/.cache/clangd/
*.swp
*.swo
*~

# OS metadata
.DS_Store
Thumbs.db

# Keep source LLVM IR tests tracked.
